# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# --- Projeto ---
PROJECT_NAME=ehc-demand-forecast
PYTHON_ENV=dev

# --- Banco de dados (SQLite) ---
DATABASE_URL=sqlite:///database/data.db
DATABASE_DIR=database
DATABASE_BACKUP=data_bkp.db

# --- JupyterLab ---
JUPYTERLAB_PORT=8888
JUPYTERLAB_HOST=127.0.0.1
JUPYTERLAB_TOKEN=troque-este-token
JUPYTERLAB_NO_BROWSER=1
JUPYTERLAB_SERVER_NAME=ehc-demand-forecast

# --- Python / paths ---
PYTHONPATH=.
MPLBACKEND=Agg
PYTHONHASHSEED=0

# --- Execuções de modelos ---
OPTUNA_N_TRIALS=100
RANDOM_SEED=42
CHECKPOINT_DIR=checkpoints
LOG_DIR=logs

# --- Logs ---
LOG_LEVEL=INFO
